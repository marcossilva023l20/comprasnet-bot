# ---------------------------------------------------------------------------
# Banco de dados (obrigatório)
# ---------------------------------------------------------------------------
# Neon (produção na Vercel) — use a string "pooled connection string" do console:
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Se o console do Neon entregar a URL com `&channel_binding=require`, tudo bem:
# o app usa o driver HTTP do Neon, que aceita o parâmetro; no caminho node-postgres
# ele é removido automaticamente.

# Postgres local (desenvolvimento):
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Opcional: forçar o driver node-postgres (pg) em vez do HTTP do Neon
# DATABASE_DRIVER=pg
# Opcional: pular as migrações automáticas do build
# SKIP_DB_MIGRATIONS=1
