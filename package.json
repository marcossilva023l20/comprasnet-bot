{
  "name": "comprasnet-bot",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node scripts/build-extension.mjs && next dev",
    "prebuild": "node scripts/build-extension.mjs",
    "build": "npm run db:migrate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "tsx --test tests/*.test.ts",
    "pretest": "node scripts/build-extension.mjs",
    "teste:extensao": "node tests/extensao-harness/harness.mjs && node tests/extensao-harness/salvar.mjs && node tests/extensao-harness/paginacao.mjs && node tests/extensao-harness/painel.mjs && node tests/extensao-harness/fontes.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "adm-zip": "^0.6.1",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.49.0",
    "next": "^16.3.8",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "ws": "^8.22.0",
    "xlsx": "npm:@e965/xlsx@^0.20.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.8",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.28",
    "tailwindcss": "4.1.17",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
